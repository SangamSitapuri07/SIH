# ORCA Box — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Supabase Cloud (Phase 2) ─────────────────────────────────────────────
# Project URL from: https://app.supabase.com/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon/public key (safe for client-side Flutter use)
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service Role key (backend-only, never expose to Flutter)
# Required for server-side Supabase operations (advisory archival, catch sync)
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ─── Ollama Local LLM (Phase 2) ───────────────────────────────────────────
# Host where Ollama is running. Defaults to localhost.
# On ORCA Box hardware (Raspberry Pi / x86 edge): set this to 127.0.0.1:11434
OLLAMA_HOST=http://localhost:11434

# Qwen3:8b is the recommended model for ORCA.
# Run: ollama pull qwen3:8b   before starting the server.
OLLAMA_MODEL=qwen3:8b

# Timeout in seconds for each Ollama LLM call.
# Must be < FastAPI route timeout. 25s gives Qwen3:8b enough time on CPU-only hardware.
OLLAMA_TIMEOUT_S=25.0

# ─── ORCA Box Server ──────────────────────────────────────────────────────
# Leave defaults for local development.
ORCA_BOX_HOST=0.0.0.0
ORCA_BOX_PORT=8000
