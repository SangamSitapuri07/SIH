# ORCA Box — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Supabase Cloud (Phase 2) ─────────────────────────────────────────────
# Project URL from: https://app.supabase.com/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon/public key (safe for client-side Flutter use)
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service Role key (backend-only, never expose to Flutter)
# Required for server-side Supabase operations (advisory archival, catch sync)
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Optional Global Fishing Watch 4Wings token (backend-only)
GFW_API_TOKEN=<your-gfw-api-token>

# ─── Ollama Local LLM (Phase 2) ───────────────────────────────────────────
# Host where Ollama is running. Defaults to localhost.
# On ORCA Box hardware (Raspberry Pi / x86 edge): set this to 127.0.0.1:11434
OLLAMA_HOST=http://localhost:11434

# Qwen3:8b is the recommended model for ORCA.
# Run: ollama pull qwen3:8b   before starting the server.
OLLAMA_MODEL=qwen3:8b

# Timeout includes first-run model loading. Qwen3:8b commonly needs more than
# 25 seconds on CPU-only laptops. ORCA sends one batched inference for all
# analytical agents and keeps the loaded model warm for 30 minutes.
OLLAMA_TIMEOUT_S=120.0
# Reserve CPU capacity for route/weather requests while local inference runs.
# Default is host CPU count minus two when omitted.
# OLLAMA_NUM_THREADS=6

# ─── ORCA Box Server ──────────────────────────────────────────────────────
# Leave defaults for local development.
ORCA_BOX_HOST=0.0.0.0
ORCA_BOX_PORT=8000

# ─── MOSDAC Provider ───────────────────────────────────────────────────────
# MOSDAC credentials (backend-only, never expose to Flutter)
MOSDAC_USERNAME=<your-mosdac-username>
MOSDAC_PASSWORD=<your-mosdac-password>

# Timeout for MOSDAC search+token+download chain (seconds).
# The full chain (search → token → download) needs more time than general providers.
ORCA_MOSDAC_TIMEOUT_SECONDS=60

# General provider timeout (used for Open-Meteo, NOAA, etc.)
ORCA_PROVIDER_TIMEOUT_SECONDS=12
